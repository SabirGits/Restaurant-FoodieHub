# Leave this UNSET (or set to "/api") to use the Vite dev-server proxy
# defined in vite.config.ts, which forwards to VITE_BACKEND_ORIGIN below —
# this avoids CORS during local development.
# VITE_API_URL="/api"

# Only used by the dev-server proxy (see vite.config.ts). Where your
# standalone backend is running locally.
VITE_BACKEND_ORIGIN="http://localhost:5000"

# For a PRODUCTION build where frontend and backend are hosted separately
# (e.g. frontend on Vercel/Netlify, backend on Render/Railway), set this to
# the backend's full public URL instead, e.g.:
# VITE_API_URL="https://your-backend.onrender.com/api"
