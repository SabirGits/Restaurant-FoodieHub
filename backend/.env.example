# Public URL of this backend (used when generating table QR codes so they
# link to the correct place). If the frontend is hosted separately, point
# this to the FRONTEND's URL instead, since the QR should open the customer site.
APP_URL="http://localhost:5173"

# Server Port for this backend API
PORT=5000

# The URL of your separately-hosted frontend, for CORS. Leave blank during
# local development to allow all origins.
FRONTEND_URL=""

# MongoDB Database URI (standard local MongoDB Compass / MongoDB server)
# When mongod is running locally or remotely, Mongoose connects directly to this URI.
# If no external MongoDB is reachable, the server automatically falls back to
# local JSON persistence in ./data — fully functional without any DB setup.
MONGODB_URI="mongodb://127.0.0.1:27017/smart_restaurant"

# JWT Authentication Secret
JWT_SECRET="smart_restaurant_jwt_secret_key_2026_production_grade"

# Default Admin Credentials for Seeding
ADMIN_DEFAULT_EMAIL="admin@restaurant.com"
ADMIN_DEFAULT_PASSWORD="Admin@123456"

# UPI and Restaurant Payment Config
# Defaults to the actual provided payment QR (public/assets/payment-qr.jpg).
# Change UPI_ID/UPI_MERCHANT_NAME and set isCustomQrImage=false in Admin Settings
# if you want the QR auto-regenerated instead of using the uploaded image.
UPI_ID="7410945190@fam"
UPI_MERCHANT_NAME="TRIO Restaurant"

# Payment Gateway Keys (Optional for live gateways)
PAYMENT_GATEWAY_KEY=""
PAYMENT_GATEWAY_SECRET=""

# --- Automatic kitchen flow (live order tracking) ---------------------------
# The customer's tracker walks forward on its own:
#   Pending -> Confirmed -> Preparing -> Ready -> Served
# Order tracker auto-advances per order: kitchen accepts within 1 min, most
# steps take 1-2 min, cooking ("Preparing") takes 5-10 min based on the dish.
# Set AUTO_ORDER_FLOW="off" to go back to fully manual kitchen control.
AUTO_ORDER_FLOW="on"
